# Copy to secrets.env and fill in real values. secrets.env is gitignored.
# All vars below are required by app/main.py.

OPENAI_API_KEY=sk-...

# Zendesk OAuth client (client-credentials grant). Zendesk has retired API
# tokens; the engine fetches a bearer token from
# https://<subdomain>.zendesk.com/oauth/tokens. The OAuth client must grant
# tickets:write + tickets:read. Create it in Admin Center > Apps and
# integrations > APIs > OAuth Clients.
ZENDESK_OAUTH_CLIENT_ID=kers_engine
ZENDESK_OAUTH_CLIENT_SECRET=...

ZENDESK_WEBHOOK_SECRET=...

# Optional overrides (defaults shown):
# Port the engine binds on 127.0.0.1. deploy/start.sh, deploy/tunnel.sh and
# both systemd units all read this, so changing it here changes it everywhere
# and the tunnel cannot drift onto the wrong port.
# ERS_PORT=8080
# ERS_MODEL=gpt-4o-2024-08-06
# ERS_DATA_DIR=./data
# ERS_TICKET_DIR=./ticket_files
# ERS_LOG_DIR=./logs
