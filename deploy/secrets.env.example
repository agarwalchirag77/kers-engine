# Copy to secrets.env and fill in real values. secrets.env is gitignored.
# All three vars below are required by app/main.py.

OPENAI_API_KEY=sk-...
ZENDESK_API_TOKEN=...
ZENDESK_WEBHOOK_SECRET=...

# Optional overrides (defaults shown):
# Port the engine binds on 127.0.0.1. deploy/start.sh, deploy/tunnel.sh and
# both systemd units all read this, so changing it here changes it everywhere
# and the tunnel cannot drift onto the wrong port.
# ERS_PORT=8080
# ERS_MODEL=gpt-4o-2024-08-06
# ERS_DATA_DIR=./data
# ERS_TICKET_DIR=./ticket_files
# ERS_LOG_DIR=./logs
